rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email.lower() == "martinherickcahuanamendoza@gmail.com"
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stock', 'category']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string &&
             (!('sku' in data) || data.sku is string) &&
             (!('authorOrBrand' in data) || data.authorOrBrand is string) &&
             (!('costPrice' in data) || data.costPrice is number) &&
             (!('minStock' in data) || data.minStock is number) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('isOffer' in data) || data.isOffer is bool) &&
             (!('offerPrice' in data) || data.offerPrice == null || data.offerPrice is number) &&
             (!('offerExpiryDate' in data) || data.offerExpiryDate == null || data.offerExpiryDate is string) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for Supplier
    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'phone']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 40 &&
             (!('ruc' in data) || data.ruc is string) &&
             (!('email' in data) || data.email is string) &&
             (!('address' in data) || data.address is string) &&
             (!('contactName' in data) || data.contactName is string) &&
             (!('category' in data) || data.category is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for Client
    function isValidClient(data) {
      return data.keys().hasAll(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             (!('doc' in data) || data.doc is string) &&
             (!('phone' in data) || data.phone is string) &&
             (!('address' in data) || data.address is string) &&
             (!('email' in data) || data.email is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for PurchaseOrder
    function isValidPurchaseOrder(data) {
      return data.keys().hasAll(['supplierId', 'supplierName', 'status', 'items']) &&
             data.supplierId is string && data.supplierId.size() > 0 && data.supplierId.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() > 0 && data.supplierName.size() <= 500 &&
             data.status is string && (data.status == 'borrador' || data.status == 'enviado' || data.status == 'recibido') &&
             data.items is list &&
             (!('notes' in data) || data.notes is string) &&
             (!('freightCost' in data) || data.freightCost is number) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for Debtor
    function isValidDebtor(data) {
      return data.keys().hasAll(['apellidosNombres', 'fecha', 'producto', 'precio', 'estado']) &&
             data.apellidosNombres is string && data.apellidosNombres.size() > 0 && data.apellidosNombres.size() <= 300 &&
             data.fecha is string && data.fecha.size() <= 50 &&
             data.producto is string && data.producto.size() > 0 && data.producto.size() <= 500 &&
             data.precio is number && data.precio >= 0 &&
             data.estado is string && (data.estado == 'Pendiente' || data.estado == 'Pagado' || data.estado == 'Vencido') &&
             (!('observacion' in data) || data.observacion is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for SalesNote
    function isValidSalesNote(data) {
      return data.keys().hasAll(['number', 'clientName', 'date', 'items', 'total']) &&
             data.number is string && data.number.size() > 0 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 400 &&
             data.date is string && data.date.size() <= 60 &&
             data.items is list &&
             data.total is number && data.total >= 0 &&
             (!('clientDoc' in data) || data.clientDoc is string) &&
             (!('subtotal' in data) || data.subtotal is number) &&
             (!('discount' in data) || data.discount is number) &&
             (!('igv' in data) || data.igv is number) &&
             (!('paymentMethod' in data) || data.paymentMethod is string) &&
             (!('status' in data) || data.status is string) &&
             (!('paidAmount' in data) || data.paidAmount is number) &&
             (!('notes' in data) || data.notes is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for ServiceTicket
    function isValidServiceTicket(data) {
      return data.keys().hasAll(['number', 'clientName', 'date', 'items', 'total']) &&
             data.number is string && data.number.size() > 0 &&
             data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 400 &&
             data.date is string && data.date.size() <= 60 &&
             data.items is list &&
             data.total is number && data.total >= 0 &&
             (!('subtotal' in data) || data.subtotal is number) &&
             (!('notes' in data) || data.notes is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for NetflixAccount
    function isValidNetflixAccount(data) {
      return data.keys().hasAll(['name', 'monthlyAmount', 'payments']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 400 &&
             data.monthlyAmount is number &&
             data.payments is map &&
             (!('phone' in data) || data.phone is string) &&
             (!('profile' in data) || data.profile is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('order' in data) || data.order is number) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // --- Collections ---

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && 
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      
      allow update: if isAdmin() && isValidProduct(incoming());
      
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Bootstrapped Admin
      allow create: if isSignedIn() && 
                    (request.auth.token.email == "martinherickcahuanamendoza@gmail.com" || request.auth.token.email.lower() == "martinherickcahuanamendoza@gmail.com") &&
                    incoming().email == request.auth.token.email &&
                    (incoming().role == "admin" || incoming().role == "owner");
                    
      allow write: if isAdmin();
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(supplierId) && isValidSupplier(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidSupplier(incoming());
      allow delete: if isAdmin();
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(clientId) && isValidClient(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidClient(incoming());
      allow delete: if isAdmin();
    }

    // Purchase Orders Collection
    match /purchase_orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(orderId) && isValidPurchaseOrder(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidPurchaseOrder(incoming());
      allow delete: if isAdmin();
    }

    // Debtors Collection
    match /debtors/{debtorId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(debtorId) && isValidDebtor(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidDebtor(incoming());
      allow delete: if isAdmin();
    }

    // Sales Notes Collection
    match /sales_notes/{noteId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(noteId) && isValidSalesNote(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidSalesNote(incoming());
      allow delete: if isAdmin();
    }

    // Service Tickets Collection (Extra incomes)
    match /service_tickets/{ticketId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(ticketId) && isValidServiceTicket(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidServiceTicket(incoming());
      allow delete: if isAdmin();
    }

    // Netflix Accounts Collection
    match /netflix_accounts/{accountId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(accountId) && isValidNetflixAccount(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidNetflixAccount(incoming());
      allow delete: if isAdmin();
    }
  }
}
