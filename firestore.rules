rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation for Product
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stock', 'category']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 500 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0 &&
             data.category is string &&
             (!('sku' in data) || data.sku is string) &&
             (!('authorOrBrand' in data) || data.authorOrBrand is string) &&
             (!('costPrice' in data) || data.costPrice is number) &&
             (!('minStock' in data) || data.minStock is number) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('isOffer' in data) || data.isOffer is bool) &&
             (!('offerPrice' in data) || data.offerPrice == null || data.offerPrice is number) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000)) &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // Validation for Supplier
    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'phone']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.phone is string && data.phone.size() <= 40 &&
             (!('ruc' in data) || data.ruc is string) &&
             (!('email' in data) || data.email is string) &&
             (!('address' in data) || data.address is string) &&
             (!('contactName' in data) || data.contactName is string) &&
             (!('category' in data) || data.category is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('createdAt' in data) || data.createdAt == request.time || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == request.time || data.updatedAt is timestamp);
    }

    // --- Collections ---

    // Products Collection
    match /products/{productId} {
      allow read: if true; // Public catalog
      
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming()) && 
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      
      allow update: if isAdmin() && isValidProduct(incoming());
      
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Bootstrapped Admin
      allow create: if isSignedIn() && 
                    request.auth.token.email == "martinherickcahuanamendoza@gmail.com" &&
                    request.auth.token.email_verified == true &&
                    incoming().email == request.auth.token.email &&
                    (incoming().role == "admin" || incoming().role == "owner");
                    
      allow write: if isAdmin();
    }

    // Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(supplierId) && isValidSupplier(incoming()) &&
                    (incoming().createdAt == request.time || incoming().createdAt is timestamp);
      allow update: if isAdmin() && isValidSupplier(incoming());
      allow delete: if isAdmin();
    }
  }
}
